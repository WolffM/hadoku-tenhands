#!/bin/sh

# --- worktree preamble ---------------------------------------------------
# git resolves a relative core.hooksPath against the WORKING TREE ROOT, so a
# hook only fires in a linked worktree when the directory holding it is tracked.
# husky's generated .husky/_ is not — its own .gitignore excludes it — so every
# commit made from a worktree ran no hook at all. Silently: no warning, no
# non-zero exit. core.hooksPath now points at .husky itself, which is tracked.
[ "${HUSKY-}" = "0" ] && exit 0

# Firing the hook is only half of it: a fresh worktree has no frontend/node_modules and
# the gates below need one. pnpm lays node_modules out as a symlink farm over
# its own .pnpm store, so a worktree on the same dependency set can borrow the
# main checkout's. A branch that genuinely CHANGES dependencies fails loudly on
# the missing package instead, and `pnpm install` here fixes that.
if [ ! -e frontend/node_modules ]; then
  common_dir=$(git rev-parse --git-common-dir)
  case "$common_dir" in /*) ;; *) common_dir="$PWD/$common_dir" ;; esac
  main_checkout=$(dirname "$common_dir")
  if [ "$main_checkout" != "$PWD" ] && [ -d "$main_checkout/frontend/node_modules" ]; then
    echo "🔗 No frontend/node_modules in this worktree — linking $main_checkout's"
    # A pnpm workspace keeps a node_modules PER PACKAGE, and a gate that shells
    # into one (themes/, worker/, ...) fails on a missing devDependency if only
    # the root is linked. So link every one the main checkout has.
    for nm in $(cd "$main_checkout" && find . -maxdepth 4 -name node_modules -prune | sed 's|^\./||'); do
      [ -e "$nm" ] && continue
      [ -d "$(dirname "$nm")" ] || continue
      ln -s "$main_checkout/$nm" "$nm"
    done
  else
    echo "❌ No frontend/node_modules — run 'pnpm install' before committing."
    exit 1
  fi
fi
# --- end worktree preamble -----------------------------------------------

echo "🔍 Running pre-commit checks..."

# Change to frontend directory for npm commands
cd frontend

# Capture originally staged files BEFORE lint/format modify them
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Auto-fix linting and formatting issues
echo "📋 Running ESLint auto-fix..."
pnpm run lint:fix
if [ $? -ne 0 ]; then
  echo "❌ ESLint found errors that could not be auto-fixed."
  echo "💡 Please fix the errors manually before committing."
  exit 1
fi

echo "✨ Auto-formatting code..."
pnpm run format

echo "✅ Linting and formatting complete!"

# TS gate — prevents commits that break tsc (resilience plan track 1)
echo "🔎 Running typecheck..."
if ! pnpm run typecheck; then
  echo "❌ TypeScript errors — fix before committing (or --no-verify to bypass)."
  exit 1
fi

# CSS gate — fails on `var(--x)` references to undeclared custom properties
# (catches typos against @wolffm/themes + local theme.css)
echo "🎨 Running stylelint..."
if ! pnpm run lint:css; then
  echo "❌ stylelint found unknown CSS custom properties — check the var name against @wolffm/themes."
  exit 1
fi

# Icon gate — fails on a raw emoji in an icon position, or an <Icon name>/
# getIconSvg() name that is not in the @wolffm/themes registry.
#
# Chained into `lint` it ran nowhere: this hook calls `lint:fix` (eslint alone),
# and no workflow called `lint` either, so the checker existed and never
# executed. It gets its own step here for the same reason typecheck and
# stylelint do.
echo "🖼️  Running the icon gate..."
if ! pnpm run lint:icons; then
  echo "❌ Raw emoji or an unknown icon name — each finding prints its own fix."
  echo "💡 An emoji that must stay (terminal/Discord/GitHub output, .textContent,"
  echo "   a text-only attribute) waives with /* check-icons-disable-next-line */."
  exit 1
fi

# Re-stage only the originally-staged files so eslint --fix / prettier edits
# land in the commit — never sweep unrelated worktree changes.
# Version bumping + publishing is owned by CI (.github/workflows/publish.yml):
# it auto-bumps to a free version and only publishes when files changed, so
# bumping here was redundant and dirtied package.json/lockfile on every commit.
cd ..
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | xargs -r git add
fi

echo "✅ All pre-commit checks passed!"
