[Unit]
# cktest-runner — Phase 0 of the the sandbox host migration. Sandbox HTTP service
# that the tenhands worker (running on the Windows main host) calls
# over the private network to execute crimson-kitty verify-phase test commands.
#
# Bring-up: see /srv/tenhands/scripts/cktest-runner/README.md.
# Wired into the per-host service-key + per-key ACL pattern documented in
# hadoku_site/docs/operations/SECRETS.md.
Description=cktest-runner — crimson-kitty verify sandbox
Documentation=file:///srv/tenhands/scripts/cktest-runner/README.md
Documentation=https://github.com/WolffM/hadoku_site/blob/main/docs/operations/cktest-runner-migration.md
After=network-online.target
Wants=network-online.target

# Restart-loop cap — these are [Unit] keys in systemd ≥230, not [Service].
# Without them here, fetch-bearer.sh failures (sealed vault, broker
# unreachable) would burn CPU on infinite restart. Same numbers as before.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=cktest
Group=cktest

# Repo lives at /srv/tenhands (a clone of WolffM/tenhands), updated
# via `git pull` on each redeploy. The service runs from inside the cloned
# tree so a code change is just `git pull && systemctl restart cktest-runner`.
WorkingDirectory=/srv/tenhands/scripts/cktest-runner

# ── Bearer fetch (fail-closed)
# fetch-bearer.sh curls the vault broker with the per-host service key
# (/etc/cktest-runner/service.key, mode 0600, owned by cktest:cktest) and
# writes /run/cktest-runner/env containing CKTEST_RUNNER_BEARER=…. If the
# vault is sealed or the service key is rejected, the unit refuses to
# start — a vault outage is a downtime signal we want surfaced, not papered
# over with a stale local file.
RuntimeDirectory=cktest-runner
RuntimeDirectoryMode=0750
ExecStartPre=/srv/tenhands/scripts/cktest-runner/fetch-bearer.sh
# Leading dash: file is created BY fetch-bearer.sh during ExecStartPre.
# Without `-`, systemd hard-fails the unit before ExecStartPre can run
# (env files are evaluated up-front; missing file = fatal load error).
# systemd reloads env from this file before each ExecStart* invocation,
# so the file written during ExecStartPre is picked up by ExecStart.
EnvironmentFile=-/run/cktest-runner/env

# Defaults; override per-host if needed.
Environment=CKTEST_PORT=5500
Environment=CKTEST_MAX_CONCURRENT=1
Environment=CKTEST_RETRY_AFTER_S=60
Environment=CKTEST_PER_JOB_TIMEOUT_S=300
Environment=PYTHONUNBUFFERED=1

# Redirect language-toolchain caches off the read-only base FS. Cheap-
# to-rebuild caches (go modules, npm, pip) go under /tmp so PrivateTmp
# wipes them on each restart — that's fine, they re-fill quickly. The
# Rust toolchain cache (rustup downloads ~300MB per version) goes to
# persistent /var/lib paths so we don't pay that cost every restart.
Environment=HOME=/tmp/cktest-home
Environment=GOPATH=/tmp/cktest-home/go
Environment=GOMODCACHE=/tmp/cktest-home/go/pkg/mod
Environment=GOCACHE=/tmp/cktest-home/go-build
Environment=XDG_CACHE_HOME=/tmp/cktest-home/.cache
Environment=npm_config_cache=/tmp/cktest-home/.npm
Environment=PNPM_HOME=/tmp/cktest-home/.pnpm
Environment=PIP_CACHE_DIR=/tmp/cktest-home/.pip-cache

# Auto-fetch the Go toolchain version the repo's go.mod requires (Go
# ≥ 1.21 built-in). Costs nothing when the local Go is already new
# enough; pulls the right version on demand when it isn't. Zero-config
# equivalent of rustup for the Go ecosystem.
Environment=GOTOOLCHAIN=auto

# rustup-managed Rust toolchains. RUSTUP_HOME holds downloaded
# toolchains (rustc/cargo/std for each version pinned by repos'
# rust-toolchain.toml); CARGO_HOME holds the registry index + cargo
# bin shims. Both must be in ReadWritePaths below and outside /tmp so
# they survive systemd unit restarts.
Environment=RUSTUP_HOME=/var/lib/cktest-rustup
Environment=CARGO_HOME=/var/lib/cktest-cargo
# Put rustup's bin first so `cargo`/`rustc` invocations hit the shims
# (which read rust-toolchain.toml) rather than any system fallback.
Environment=PATH=/var/lib/cktest-cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStart=/usr/bin/python3 server.py

# ── Resilience
Restart=always
RestartSec=5
# Restart-loop cap moved to [Unit] section above (systemd ≥230 requirement).

# ── Hardening (light touch — the service runs untrusted shell commands
# from the agent allowlist by design, so heavy seccomp filters would
# break legit test runs).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Allow writes to /tmp (for cktest-* clone dirs + cheap language
# caches) and the persistent rustup/cargo dirs. /var/tmp is included
# as a fallback for tools that ignore TMPDIR.
ReadWritePaths=/tmp /var/tmp /var/lib/cktest-rustup /var/lib/cktest-cargo
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
