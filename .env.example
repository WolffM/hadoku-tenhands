# tenhands environment configuration
#
# Copy this file to .env and fill in your values.
# Do NOT commit .env — it contains secrets.

# ── Aggregator API ──────────────────────────────────────────────────
# Base URL for the aggregator scoring/analysis API.
# Leave empty to run in offline/fallback mode (gh CLI + local heuristic).
AGGREGATOR_API_URL=https://your-aggregator.example.com/oss/api

# ── Flask Backend ───────────────────────────────────────────────────
# Set to "development" to enable Flask debug mode and extended cache TTL (1 hr).
FLASK_ENV=development

# Port the Flask backend listens on (default: 5000).
PORT=5000

# URL prefix for all API routes. Production uses "/dispatch" (behind edge-router).
# Set to "" for local development without a prefix.
URL_PREFIX=/dispatch

# ── Caching ─────────────────────────────────────────────────────────
# Set to "1" to force extended cache TTL (1 hr) regardless of FLASK_ENV.
# LOCAL_CACHE=1

# Set to "1" to disable file-based caching entirely.
# CACHE_DISABLED=1

# ── Debug Route Auth ──────────────────────────────────────────────
# When set, all /api/oss/debug/* endpoints require this key via
# X-Admin-Key header or admin_key query param. Leave unset for local dev.
ADMIN_KEY=

# ── Discord Notifications ──────────────────────────────────────────
# Webhook URL for pipeline event notifications (GO-tier issues, upstream PR merged, etc.).
# Leave empty to disable Discord notifications.
DISCORD_WEBHOOK_URL=

# ── Frontend (Vite) ────────────────────────────────────────────────
# Backend port that Vite's dev proxy forwards /dispatch/* requests to.
# Must match PORT above. Only used during `pnpm dev`.
BACKEND_PORT=5000

# ── CI (set automatically in CI/CD pipelines) ──────────────────────
# Standard CI flag. Playwright uses this to adjust retries and workers.
# CI=true
