{
  "name": "@wolffm/tenhands",
  "version": "1.14.5",
  "description": "TenHands UI - Task dispatch and management interface",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/tenhands.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "predev": "node scripts/kill-port.cjs 5184",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky",
    "test": "pw-isolated playwright test --project=chromium",
    "test:ui": "pw-isolated playwright test --project=chromium --ui",
    "test:headed": "pw-isolated playwright test --project=chromium --headed",
    "test:debug": "pw-isolated playwright test --project=chromium --debug",
    "test:prod": "pw-isolated playwright test --project=prod",
    "test:prod:ui": "pw-isolated playwright test --project=prod --ui",
    "test:prod:headed": "pw-isolated playwright test --project=prod --headed",
    "test:prod:debug": "pw-isolated playwright test --project=prod --debug"
  },
  "peerDependencies": {
    "@wolffm/logger": ">=1.0.0",
    "@wolffm/task-ui-components": "^3.0.0",
    "@wolffm/themes": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "dompurify": "^3.2.2",
    "marked": "^17.0.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^5.1.0",
    "@wolffm/logger": "^1.3.1",
    "@wolffm/task-ui-components": "^4.0.2",
    "@wolffm/themes": "^5.0.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stylelint": "^17.12.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^5.6.3",
    "vite": "^7.1.12"
  }
}
