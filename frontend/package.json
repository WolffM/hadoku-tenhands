{
  "name": "@wolffm/tenhands",
  "version": "1.14.5",
  "description": "TenHands UI - Task dispatch and management interface",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-tenhands.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "predev": "node scripts/kill-port.cjs 5184",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build -c vite.demo.config.ts",
    "preview:demo": "vite preview -c vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky",
    "test": "pw-isolated playwright test --project=local",
    "test:ui": "pw-isolated playwright test --project=local --ui",
    "test:headed": "pw-isolated playwright test --project=local --headed",
    "test:debug": "pw-isolated playwright test --project=local --debug",
    "test:prod": "pw-isolated playwright test --project=prod",
    "test:prod:ui": "pw-isolated playwright test --project=prod --ui",
    "test:prod:headed": "pw-isolated playwright test --project=prod --headed",
    "test:prod:debug": "pw-isolated playwright test --project=prod --debug"
  },
  "peerDependencies": {
    "@wolffm/logger": ">=1.0.0",
    "@wolffm/task-ui-components": ">=3.0.0",
    "@wolffm/themes": "^5.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@wolffm/logger": "^1.3.1",
    "@wolffm/task-ui-components": "^4.5.5",
    "@wolffm/themes": "^5.5.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^17.14.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
